
<title>Triton Grid Control</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
  /* Instrumentation console palette: desaturated, semantic color reserved for
     state, one restrained categorical set for the four energy sources. No
     decorative gradients, no glow, no tinted icon chips. */
  :root{
    --bg-deep:#F7F3EA; --bg-panel:#F7F3EA; --bg-panel-raised:#FFFFFF;
    --border:#DDD5C0; --border-soft:#EAE4D4;
    --ink-primary:#1A1814; --ink-secondary:#5B5748; --ink-muted:#8F8A78;
    --accent-solar:#B8862A; --accent-wind:#1F8776; --accent-battery:#33488A; --accent-diesel:#833A29;
    --status-good:#1E7A46; --status-warn:#8A5A0A; --status-critical:#A82B22;
    --focus:#33488A;
    --water:#C7DCE6; --water-line:#AECAD8; --land:#DCD3B6; --land-line:#B9AE88;
  }
  /* NOTE: dark mode no longer follows the viewer's OS/browser preference —
     it previously did via `@media (prefers-color-scheme: dark)`, which meant
     the dashboard silently looked like the old console theme for anyone
     whose system was set to dark mode, with no on-page indication why. The
     warm/light theme above is now what everyone sees by default. Dark mode
     is still available on request via `data-theme="dark"` on <html> (e.g.
     for a future manual toggle button) — see the block below. */
  :root[data-theme="dark"]{
    --bg-deep:#0A0C10; --bg-panel:#10131A; --bg-panel-raised:#161A22;
    --border:#2B313C; --border-soft:#1E232C;
    --ink-primary:#C7CCD3; --ink-secondary:#8B929E; --ink-muted:#575E6A;
    --accent-solar:#B98A3D; --accent-wind:#3FA79C; --accent-battery:#7B8FD4; --accent-diesel:#C07657;
    --status-good:#4C9A6A; --status-warn:#C99A3D; --status-critical:#C4534A;
    --focus:#7B8FD4;
    --water:#141D26; --water-line:#1C2833; --land:#262A22; --land-line:#3A3F33;
  }
 
  *{box-sizing:border-box;}
  body{
    background:var(--bg-deep); color:var(--ink-primary);
    font-family:'IBM Plex Sans',system-ui,-apple-system,sans-serif;
    font-size:13px; line-height:1.5;
  }
  ::selection{ background:var(--focus); color:#fff; }
  .mono{ font-family:'IBM Plex Mono',ui-monospace,monospace; font-variant-numeric:tabular-nums; }
  .cond{ font-family:'IBM Plex Sans Condensed','IBM Plex Sans',sans-serif; }
 
  a{ color:var(--ink-secondary); }
  code{ font-family:'IBM Plex Mono',monospace; }
 
  .app{ max-width:1600px; margin:0 auto; padding:0 14px 28px; }
 
  /* ---------- header: plain instrument nameplate, not a branded card ---------- */
  .topbar{
    display:flex; align-items:center; gap:16px; padding:8px 2px;
    background:var(--bg-deep); border-bottom:1px solid var(--border);
    margin-bottom:12px; flex-wrap:wrap; row-gap:6px;
  }
  .brand{ display:flex; align-items:center; gap:9px; }
  .brand .mark{
    font-family:'IBM Plex Sans',sans-serif; font-weight:700; font-size:17px;
    letter-spacing:.01em; color:var(--ink-primary); text-transform:uppercase;
  }
  .brand .sub{ color:var(--ink-muted); font-size:10.5px; text-transform:uppercase; letter-spacing:.06em; }
  .brand .simtag{
    font-family:'IBM Plex Mono',monospace; font-size:9px; font-weight:600; letter-spacing:.06em;
    color:var(--ink-muted); border:1px solid var(--border); padding:1px 6px; border-radius:3px;
  }
  .topbar .divider{ width:1px; align-self:stretch; background:var(--border); margin:2px 0; }
  .clock{ display:flex; flex-direction:column; gap:0; }
  .clock .time{ font-family:'IBM Plex Mono',monospace; font-size:21px; font-weight:600; font-variant-numeric:tabular-nums; letter-spacing:.01em; }
  .clock .date{ font-size:10px; color:var(--ink-muted); text-transform:uppercase; letter-spacing:.05em; }
 
  .stat-readout{ display:flex; flex-direction:column; gap:0; }
  .stat-readout .lbl{ font-size:9px; color:var(--ink-muted); text-transform:uppercase; letter-spacing:.06em; }
  .stat-readout .val{ font-family:'IBM Plex Mono',monospace; font-size:14px; font-weight:600; letter-spacing:.01em; }
  .stat-readout .val.warn{ color:var(--status-warn); }
  .stat-readout .val.critical{ color:var(--status-critical); }
 
  .health{ display:flex; align-items:center; gap:7px; margin-left:auto; font-size:11px; font-weight:600; letter-spacing:.03em; text-transform:uppercase; }
  .health .led{ width:7px; height:7px; flex:none; }
  .health.good{ color:var(--status-good); } .health.good .led{ background:var(--status-good); }
  .health.warn{ color:var(--status-warn); } .health.warn .led{ background:var(--status-warn); }
  .health.critical{ color:var(--status-critical); } .health.critical .led{ background:var(--status-critical); }
 
  .controls{ display:flex; align-items:center; gap:10px; }
  button{ font-family:inherit; cursor:pointer; }
  .btn{
    background:var(--bg-panel-raised); color:var(--ink-secondary); border:1px solid var(--border);
    border-radius:4px; padding:5px 11px; font-size:11px; font-weight:600; letter-spacing:.02em;
    text-transform:uppercase; transition:background-color .1s, color .1s;
  }
  .btn:hover{ color:var(--ink-primary); border-color:var(--ink-muted); }
  .btn:focus-visible, .seg button:focus-visible{ outline:2px solid var(--focus); outline-offset:1px; }
  .seg{ display:flex; border:1px solid var(--border); border-radius:4px; overflow:hidden; }
  .seg button{
    background:var(--bg-panel-raised); border:0; color:var(--ink-secondary); padding:5px 9px; font-size:11px; font-weight:600;
    text-transform:uppercase; letter-spacing:.02em; border-right:1px solid var(--border);
  }
  .seg button:last-child{ border-right:0; }
  .seg button.active{ background:var(--ink-primary); color:var(--bg-panel); }
 
  .grp{ display:flex; border:1px solid var(--border); border-radius:4px; overflow:hidden; }
  .grp .btn{ border:0; border-right:1px solid var(--border); border-radius:0; }
  .grp .btn:last-child{ border-right:0; }
  .scenario-btn[data-armed="true"]{ background:var(--status-warn); color:var(--bg-panel); border-color:var(--status-warn); }
 
  /* ---------- mission strip: states the problem in one line, above the
     live decision bar, so PROBLEM and DECISION are both readable without
     scrolling (see decision-bar below for the "TRITON / DECISION" half). ---------- */
  .mission-strip{
    font-size:11.5px; color:var(--ink-secondary); line-height:1.5;
    padding:9px 2px 12px; border-bottom:1px solid var(--border-soft); margin-bottom:12px;
  }
  .mission-strip .m-label{
    font-weight:700; text-transform:uppercase; letter-spacing:.06em; font-size:10px;
    color:var(--ink-muted); margin-right:7px;
  }
 
  /* ---------- decision bar: judge-facing hero ---------- */
  .decision-bar{
    display:flex; align-items:center; gap:14px; padding:12px 16px; margin-bottom:12px; border-radius:6px;
    background:var(--bg-panel-raised); border:1px solid var(--border); flex-wrap:wrap; row-gap:8px;
  }
  .decision-risk{ display:flex; align-items:center; gap:7px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.03em; flex:none; }
  .decision-risk .d{ width:8px; height:8px; flex:none; }
  .decision-risk.good{ color:var(--status-good); } .decision-risk.good .d{ background:var(--status-good); }
  .decision-risk.warn{ color:var(--status-warn); } .decision-risk.warn .d{ background:var(--status-warn); }
  .decision-risk.critical{ color:var(--status-critical); } .decision-risk.critical .d{ background:var(--status-critical); }
  .decision-main{ display:flex; align-items:baseline; gap:9px; flex:1 1 320px; min-width:0; }
  .decision-label{ font-size:10px; color:var(--ink-muted); text-transform:uppercase; letter-spacing:.06em; flex:none; }
  .decision-text{ font-size:12.5px; color:var(--ink-primary); font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .demo-controls{ display:flex; gap:8px; }
 
  /* ---------- drawers (Why? / 24h impact) ---------- */
  .drawer{ background:var(--bg-panel-raised); border:1px solid var(--border); padding:14px 16px; margin-bottom:12px; border-radius:6px; }
  .trace-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px; }
  .trace-block .t-label{ font-size:9.5px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-muted); margin-bottom:5px; }
  .trace-block .t-body{ font-size:11.5px; color:var(--ink-secondary); line-height:1.55; }
  .trace-block .t-body code{ font-size:10.5px; }
  .trace-block ul{ margin:0; padding-left:16px; }
  .impact-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:14px; }
  .impact-stat .i-label{ font-size:9.5px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--ink-muted); margin-bottom:4px; }
  .impact-stat .i-value{ font-family:'IBM Plex Mono',monospace; font-size:19px; font-weight:600; color:var(--ink-primary); }
  .impact-stat .i-sub{ font-size:10px; color:var(--ink-muted); margin-top:2px; }
 
  /* ---------- architecture modal ---------- */
  .modal-overlay{ position:fixed; inset:0; background:color-mix(in srgb, var(--bg-deep) 70%, transparent); z-index:50; padding:20px; }
  .modal-overlay:not([hidden]){ display:flex; align-items:center; justify-content:center; }
  .modal{ background:var(--bg-panel-raised); border:1px solid var(--border); border-radius:8px; max-width:640px; width:100%; max-height:85vh; overflow-y:auto; }
  .modal-head{ display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid var(--border); }
  .modal-body{ padding:14px 16px; }
  .arch-diagram{ font-size:10.5px; line-height:1.5; color:var(--ink-secondary); background:var(--bg-panel-raised); border:1px solid var(--border-soft); padding:12px; overflow-x:auto; margin:0 0 14px; white-space:pre; }
  .arch-table{ width:100%; border-collapse:collapse; font-size:11.5px; margin-bottom:12px; }
  .arch-table th{ text-align:left; font-size:10px; text-transform:uppercase; letter-spacing:.05em; color:var(--ink-muted); padding:0 8px 6px; border-bottom:1px solid var(--border); }
  .arch-table td{ padding:7px 8px; border-bottom:1px solid var(--border-soft); vertical-align:top; color:var(--ink-secondary); }
  .arch-table td.sim{ color:var(--ink-secondary); }
  .arch-table td.real{ color:var(--ink-primary); }
  .arch-table code{ font-size:10.5px; }
 
  /* ---------- layout grid ---------- */
  .grid{ display:grid; grid-template-columns:270px 1fr 340px; gap:26px;
    background:transparent; border:0; }
  .rail-left, .rail-center, .rail-right{ background:transparent; }
  @media (max-width:1180px){ .grid{ grid-template-columns:1fr 1fr; } .rail-right{ grid-column:1/-1; } }
  @media (max-width:760px){ .grid{ grid-template-columns:1fr; } .rail-right{ grid-column:auto; } }
 
  .panel{
    background:transparent; padding:0; border:0;
  }
  .rail-center .panel + .panel{ border-top:0; margin-top:22px; }
  .bottom-panel{ margin-top:26px; padding-top:20px; border-top:1px solid var(--border-soft); }
  .panel-title{
    font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.07em;
    color:var(--ink-muted); margin:0 0 13px; display:flex; align-items:baseline; justify-content:space-between;
  }
  .panel-title .aux{ font-weight:500; color:var(--ink-muted); text-transform:none; letter-spacing:0; font-size:10px; }
  .panel-title .seg{ margin-left:auto; }
  .panel-title .seg button{ padding:3px 9px; font-size:9.5px; }
 
  /* ---------- telemetry (left rail) ---------- */
  .telemetry{ width:100%; border-collapse:collapse; }
  .telemetry td{ padding:8px 0; vertical-align:baseline; border-bottom:1px solid var(--border-soft); }
  .telemetry tr:last-child td{ border-bottom:0; }
  .telemetry .tag{ font-size:11px; color:var(--ink-secondary); font-weight:600; white-space:nowrap; }
  .telemetry .sub{ display:block; font-size:9.5px; color:var(--ink-muted); font-weight:400; margin-top:1px; }
  .telemetry .val-cell{ text-align:right; }
  .telemetry .val{ font-family:'IBM Plex Mono',monospace; font-size:13px; font-weight:600; color:var(--ink-primary); white-space:nowrap; }
  .telemetry .val small{ font-size:9.5px; color:var(--ink-muted); font-weight:500; margin-left:1px; }
  .telemetry .flag{ font-family:'IBM Plex Mono',monospace; font-size:9.5px; font-weight:700; letter-spacing:.03em; }
  .telemetry .bar-row td{ padding-top:0; padding-bottom:12px; border-bottom:1px solid var(--border-soft); }
  .telemetry tr:last-child .bar-row td{ border-bottom:0; }
  .tbar{ height:4px; background:var(--border-soft); margin-top:5px; border-radius:2px; overflow:hidden; }
  .tbar > i{ display:block; height:100%; border-radius:2px; }
 
  /* ---------- flow diagram ---------- */
  .flow-wrap{ width:100%; overflow-x:auto; }
  .flow-svg{ width:100%; min-width:600px; height:210px; display:block; }
  .flow-node rect{ fill:var(--bg-panel-raised); stroke:var(--border); }
  .flow-node text.n-label{ fill:var(--ink-muted); font-family:'IBM Plex Sans'; font-size:9.5px; font-weight:600; text-transform:uppercase; letter-spacing:.05em; }
  .flow-node text.n-value{ fill:var(--ink-primary); font-family:'IBM Plex Mono'; font-size:12.5px; font-weight:600; }
  .flow-edge{ fill:none; transition:stroke-width .4s ease, opacity .4s ease, stroke .4s ease; }
  .flow-edge.animated{ stroke-dasharray:5 6; animation:dash 1.1s linear infinite; }
  @keyframes dash{ to{ stroke-dashoffset:-11; } }
  @media (prefers-reduced-motion: reduce){ .flow-edge.animated{ animation:none; } }
  .flow-shed-badge{ font-family:'IBM Plex Mono'; font-size:9px; font-weight:700; fill:var(--status-critical); }
 
  /* ---------- island map ---------- */
  .map-water{ fill:var(--water); }
  .map-water-line{ fill:none; stroke:var(--water-line); stroke-width:1; }
  .map-land{ fill:var(--land); stroke:var(--land-line); stroke-width:1.2; }
  .map-ridge{ fill:none; stroke:var(--land-line); stroke-width:1; stroke-dasharray:1 4; stroke-linecap:round; }
  .map-pin circle{ stroke:var(--bg-panel); stroke-width:1.5; }
  .map-pin text.p-label{ fill:var(--ink-secondary); font-family:'IBM Plex Sans Condensed','IBM Plex Sans'; font-size:9px; font-weight:600; text-transform:uppercase; letter-spacing:.03em; }
  .map-pin text.p-value{ fill:var(--ink-primary); font-family:'IBM Plex Mono'; font-size:9.5px; font-weight:600; }
  .map-pin text.p-flag{ fill:var(--status-critical); font-family:'IBM Plex Mono'; font-size:8.5px; font-weight:700; }
  .map-legend{ display:flex; flex-wrap:wrap; gap:12px; margin-top:9px; padding-top:9px; border-top:1px solid var(--border-soft); }
  .map-legend .item{ display:flex; align-items:center; gap:5px; font-size:10px; color:var(--ink-muted); text-transform:uppercase; letter-spacing:.02em; }
  .map-legend .sw{ width:8px; height:8px; border-radius:50%; flex:none; }
 
  /* ---------- chart ---------- */
  .chart-wrap{ width:100%; overflow-x:auto; }
  .chart-svg{ width:100%; min-width:600px; height:220px; display:block; overflow:visible; }
  .chart-axis-label{ fill:var(--ink-muted); font-family:'IBM Plex Mono'; font-size:9.5px; }
  .gridline{ stroke:var(--border-soft); stroke-width:1; }
  .series-path{ fill:none; stroke-width:1.5; }
  .series-area{ opacity:.08; }
  .legend{ display:flex; gap:16px; flex-wrap:wrap; margin-top:9px; padding-top:9px; border-top:1px solid var(--border-soft); }
  .legend .item{ display:flex; align-items:center; gap:6px; font-size:10.5px; color:var(--ink-secondary); text-transform:uppercase; letter-spacing:.02em; }
  .legend .swatch{ width:12px; height:2px; }
  .legend .swatch.dashed{ background:none; border-top:2px dashed var(--ink-muted); height:0; }
  .chart-tooltip{
    position:absolute; pointer-events:none; background:var(--bg-panel-raised); border:1px solid var(--border);
    border-radius:4px; box-shadow:0 2px 8px rgba(26,24,20,.08);
    padding:6px 9px; font-size:10.5px; opacity:0; transition:opacity .1s;
    font-family:'IBM Plex Mono',monospace; white-space:nowrap; z-index:5;
  }
  .chart-tooltip .tt-row{ display:flex; justify-content:space-between; gap:12px; }
  .chart-tooltip .tt-row + .tt-row{ margin-top:2px; }
  .chart-hover-line{ stroke:var(--ink-muted); stroke-width:1; stroke-dasharray:2 2; opacity:0; }
 
  /* ---------- event log (right rail) ---------- */
  .rail-right{ position:relative; }
  .eventlog{ width:100%; border-collapse:collapse; }
  .eventlog-wrap{ max-height:440px; overflow-y:auto; }
  .eventlog td{ padding:5px 6px; border-bottom:1px solid var(--border-soft); vertical-align:top; font-size:11px; }
  .eventlog tr:last-child td{ border-bottom:0; }
  .eventlog .ts{ font-family:'IBM Plex Mono',monospace; font-size:9.5px; color:var(--ink-muted); white-space:nowrap; padding-top:6px; }
  .eventlog .sev{ font-family:'IBM Plex Mono',monospace; font-size:9.5px; font-weight:700; white-space:nowrap; padding-top:6px; }
  .eventlog .sev.info{ color:var(--ink-muted); }
  .eventlog .sev.warn{ color:var(--status-warn); }
  .eventlog .sev.critical{ color:var(--status-critical); }
  .eventlog .msg{ color:var(--ink-secondary); line-height:1.45; }
  .eventlog tr.critical{ background:color-mix(in srgb, var(--status-critical) 7%, transparent); }
  .eventlog-empty{ font-size:11px; color:var(--ink-muted); padding:6px 0; }
  .agent-note{ font-size:10px; color:var(--ink-muted); margin-top:10px; line-height:1.5; border-top:1px solid var(--border-soft); padding-top:9px; }
 
  .ask-box{ display:flex; align-items:center; gap:0; margin-bottom:12px; border:1px solid var(--border); background:var(--bg-panel-raised); border-radius:4px; overflow:hidden; }
  .ask-box .prompt{ font-family:'IBM Plex Mono',monospace; color:var(--ink-muted); padding:0 0 0 8px; font-size:12px; }
  .ask-box input{
    flex:1; background:transparent; border:0; padding:7px 6px;
    color:var(--ink-primary); font-family:'IBM Plex Mono',monospace; font-size:11.5px;
  }
  /* Keyboard focus indicator: the input's own native outline is suppressed
     because it looks broken clipped inside the bordered ask-box, but focus
     must still be visible somewhere — :focus-within lights up the whole box
     instead, and the submit button keeps its own explicit ring. */
  .ask-box:focus-within{ outline:2px solid var(--focus); outline-offset:1px; border-radius:5px; }
  .ask-box input:focus{ outline:none; }
  .ask-box input::placeholder{ color:var(--ink-muted); }
  .ask-box button{ background:var(--ink-primary); color:var(--bg-panel-raised); border:0;
    padding:0 14px; height:32px; font-weight:700; font-size:10.5px; text-transform:uppercase; letter-spacing:.04em; }
  .ask-box button:hover{ background:var(--ink-secondary); }
  .ask-box button:focus-visible{ outline:2px solid var(--focus); outline-offset:-2px; }
 
  /* ---------- sector strip ---------- */
  .sectors-table{ width:100%; border-collapse:collapse; font-size:11.5px; }
  .sectors-table th{ text-align:left; font-size:10px; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-muted); font-weight:600; padding:0 10px 7px; border-bottom:1px solid var(--border); }
  .sectors-table td{ padding:7px 10px; border-bottom:1px solid var(--border-soft); vertical-align:middle; }
  .sectors-table tr:last-child td{ border-bottom:0; }
  .sectors-table tr:hover td{ background:var(--bg-panel-raised); }
  .sectors-table .kw{ font-family:'IBM Plex Mono',monospace; font-variant-numeric:tabular-nums; }
  .tier-tag{ font-family:'IBM Plex Mono',monospace; font-size:10.5px; font-weight:700; letter-spacing:.02em; }
  .tier-tag.t0{ color:var(--status-critical); }
  .tier-tag.t1{ color:var(--accent-battery); }
  .tier-tag.t2{ color:var(--ink-muted); }
  .status-chip{ display:inline-flex; align-items:center; gap:5px; font-size:10.5px; font-weight:600; text-transform:uppercase; letter-spacing:.03em; }
  .status-chip .d{ width:6px; height:6px; }
  .status-chip.normal{ color:var(--ink-muted); } .status-chip.normal .d{ background:var(--status-good); }
  .status-chip.shed{ color:var(--status-critical); } .status-chip.shed .d{ background:var(--status-critical); }
  .bar-cell{ display:flex; align-items:center; gap:8px; }
  .bar-track{ width:64px; height:4px; background:var(--border-soft); }
  .bar-fill{ height:100%; }
 
  .footer-note{ margin-top:16px; padding:0 16px; font-size:10.5px; color:var(--ink-muted); text-align:center; line-height:1.6; }
  .footer-note a{ color:var(--ink-secondary); text-decoration:underline; text-underline-offset:2px; }
 
  ::-webkit-scrollbar{ width:8px; height:8px; }
  ::-webkit-scrollbar-thumb{ background:var(--border); }
  ::-webkit-scrollbar-track{ background:transparent; }
</style>
 
<div class="app">
 
  <div class="topbar">
    <div class="brand">
      <span class="mark">Triton EMS</span>
      <span class="sub">Kailoa Isl. · Unit 1</span>
      <span class="simtag">SIMULATION</span>
    </div>
    <div class="divider"></div>
    <div class="clock">
      <span class="time mono" id="simTime">--:--</span>
      <span class="date" id="simDate">—</span>
    </div>
    <div class="divider"></div>
    <div class="stat-readout">
      <span class="lbl">Sys Freq</span>
      <span class="val mono" id="statFreq">60.00 Hz</span>
    </div>
    <div class="stat-readout">
      <span class="lbl">Bus kV</span>
      <span class="val mono" id="statVoltage">13.80 kV</span>
    </div>
    <div class="divider"></div>
    <div class="controls">
      <div class="seg" id="speedSeg" role="group" aria-label="Simulation speed">
        <button data-speed="0" aria-label="Pause simulation">Hold</button>
        <button data-speed="1" class="active" aria-label="Run simulation at normal speed">1×</button>
        <button data-speed="4" aria-label="Run simulation at 4 times speed">4×</button>
        <button data-speed="20" aria-label="Run simulation at 20 times speed">20×</button>
      </div>
