  function smoothClosedPath(pts){
    // Quadratic-midpoint smoothing through a closed point ring — turns a
    // hand-placed polygon into an organic coastline without hand-authoring
    // bezier control points.
    const n = pts.length;
    const mid = (a,b)=>[(a[0]+b[0])/2,(a[1]+b[1])/2];
    const start = mid(pts[n-1], pts[0]);
    let d = `M${start[0].toFixed(1)},${start[1].toFixed(1)} `;
    for(let i=0;i<n;i++){
      const p = pts[i], next = pts[(i+1)%n], m = mid(p,next);
      d += `Q${p[0].toFixed(1)},${p[1].toFixed(1)} ${m[0].toFixed(1)},${m[1].toFixed(1)} `;
    }
    return d + 'Z';
  }
 
