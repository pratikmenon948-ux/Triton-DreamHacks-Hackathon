<script>
(function(){
  "use strict";
 
  /* ============================== MODEL ============================== */
  const SECTORS = [
    {name:"Hospital & Clinic", tier:0, base:42, varf:0.05, peak:[8,9,10,18,19], mult:1.15, shed:0.0},
    {name:"Desalination Plant", tier:0, base:95, varf:0.10, peak:[6,7,8,17,18], mult:1.2, shed:0.0},
    {name:"Comms & Emergency", tier:0, base:12, varf:0.03, peak:[], mult:1.0, shed:0.0},
    {name:"Village Households (N)", tier:1, base:140, varf:0.20, peak:[6,7,18,19,20,21], mult:1.6, shed:0.15},
    {name:"School", tier:1, base:18, varf:0.15, peak:[8,9,10,11,12,13], mult:1.4, shed:0.30},
    {name:"Fishery Cold Storage", tier:1, base:55, varf:0.08, peak:[], mult:1.0, shed:0.10},
    {name:"Village Households (S)", tier:1, base:125, varf:0.20, peak:[6,7,18,19,20,21], mult:1.6, shed:0.15},
    {name:"Tourism / Commercial", tier:2, base:70, varf:0.30, peak:[9,10,17,18,19,20], mult:1.5, shed:0.55},
    {name:"EV & Boat Charging", tier:2, base:30, varf:0.40, peak:[22,23,0,1], mult:2.0, shed:0.90},
    {name:"Ice Plant", tier:2, base:40, varf:0.15, peak:[], mult:1.0, shed:0.70},
  ];
 
  const CAP = { solar:650, wind:260, battery:2200, diesel:720, tank:7000 };
  const RESERVE_FLOOR=20, EMERGENCY_FLOOR=5, CHG_EFF=0.94, DIS_EFF=0.96, FUEL_L_PER_KWH=0.28, STEP_H=0.25;
  const RESUPPLY_THRESHOLD_L=1500, RESUPPLY_LEAD_HOURS=14;
 
  let rngState = 42;
  function rng(){ rngState = (rngState*1103515245+12345)&0x7fffffff; return rngState/0x7fffffff; }
  function ru(a,b){ return a+(b-a)*rng(); }
 
  let simT = new Date(2026,7,24,0,0,0);
  let battery = 68.0, fuel = CAP.tank*0.8;
  let shedPointer = 0;
  let scenario = null, scenarioTicksLeft = 0, stuckVal = null;
  let resupplyTicksLeft = null; // null = no delivery in transit
  let demo = null; // crisis-demo state: {step, ticksLeft, savedSpeed, paused} — null when not running
  let speed = 1; // ticks of sim per real second-ish (handled via interval)
  let history = []; // last N dispatch snapshots for chart
  const HISTORY_MAX = 96; // 24h at 15-min steps
  let lastDispatch = null, lastState = null;
  let agentLog = []; // {t, sev, text}
 
  function solarModel(hourFloat, cloud){
    let base;
    if(hourFloat < 5.75 || hourFloat > 18.25) base = 0;
    else { const x=(hourFloat-12.0)/6.25; base = Math.max(0, Math.cos(x*Math.PI/2)) ** 1.3; }
    return 1000 * base * (1-0.85*cloud);
  }
 
  function tick(){
    simT = new Date(simT.getTime() + 15*60000);
    const hour = simT.getHours() + simT.getMinutes()/60;
    const dayOfYear = Math.floor((simT - new Date(simT.getFullYear(),0,0))/86400000);
 
    const stormActive = scenario==="storm" && scenarioTicksLeft>0;
    let cloud = Math.min(0.95, Math.max(0.05, 0.35 + 0.25*Math.sin(dayOfYear+hour/4) + ru(-0.08,0.08)));
    if(stormActive) cloud = Math.min(0.98, cloud+0.5);
 
    let irr = solarModel(hour, cloud) * ru(0.97,1.03);
    const solarKw = Math.min(CAP.solar, CAP.solar*(irr/1000));
 
    let windBase = 6.5 + 3.0*Math.sin(hour/24*2*Math.PI+1.0) + ru(-1.2,1.2);
    if(stormActive) windBase += 9.0;
    const windSpeed = Math.max(0, windBase);
    let windKw;
    if(windSpeed<3 || windSpeed>25) windKw=0;
    else if(windSpeed>=12) windKw=CAP.wind;
    else { const f=((windSpeed-3)/9)**2; windKw=CAP.wind*f; }
 
    const ambientTemp = 27.0 + 3.5*Math.sin((hour-9)/24*2*Math.PI) + ru(-0.6,0.6) - (stormActive?2:0);
 
    const faults = [];
    let dieselAvailable = true;
    if(scenario==="generator_fault" && scenarioTicksLeft>0){ dieselAvailable=false; faults.push("diesel_genset_fault"); }
 
    let desalFlow = 420 + 40*Math.sin(hour/24*2*Math.PI) + ru(-15,15);
    const desalPressure = 4.2+ru(-0.15,0.15);
    if(scenario==="sensor_stuck" && scenarioTicksLeft>0){
      if(stuckVal===null) stuckVal = desalFlow;
      desalFlow = stuckVal;
      faults.push("desal_flow_sensor_stuck");
    }
 
    if(scenarioTicksLeft>0){
      scenarioTicksLeft--;
      if(scenarioTicksLeft===0){ scenario=null; stuckVal=null; }
    }
 
    const sectorLoads = {};
    for(const s of SECTORS){
      const isPeak = s.peak.includes(Math.floor(hour));
      const m = isPeak ? s.mult : 1.0;
      const noise = 1 + ru(-s.varf, s.varf);
      sectorLoads[s.name] = s.base*m*noise;
    }
    const demand = Object.values(sectorLoads).reduce((a,b)=>a+b,0);
    const renewable = solarKw + windKw;
 
    // Diesel resupply: a real island tank is refilled by a periodic supply
    // boat, not an infinite reservoir. Below threshold a delivery is called
    // in and arrives after RESUPPLY_LEAD_HOURS. Mirrors _resupply_diesel()
    // in sensors.py — without this, fuel-limited diesel dispatch (below)
    // would run the tank dry once and never recover.
    let resupplyEtaHours = null;
    if(resupplyTicksLeft === null){
      if(fuel < RESUPPLY_THRESHOLD_L) resupplyTicksLeft = RESUPPLY_LEAD_HOURS*4;
    }
    if(resupplyTicksLeft !== null){
      resupplyTicksLeft--;
      if(resupplyTicksLeft <= 0){ fuel = CAP.tank; resupplyTicksLeft = null; }
      else resupplyEtaHours = resupplyTicksLeft/4;
    }
 
    // ---- dispatch (mirrors optimizer.py's merit order + DecisionTrace) ----
    let residual = demand - renewable;
    let socKwh = battery/100*CAP.battery;
    let batteryFlow=0, dieselKw=0, shedKw=0, shedSectors=[], tier0Risk=false, unmetKw=0, notes=[];
    const socBeforePct = battery;
    const constraints = [
      `battery reserve floor ${RESERVE_FLOOR}% (emergency floor ${EMERGENCY_FLOOR}%)`,
      `diesel genset capacity ${CAP.diesel} kW`,
      "Tier-0 sectors (hospital, desalination, comms) are never automatically shed",
    ];
    let decision = "";
 
    if(residual < 0){
      const surplus = -residual;
      const headroom = CAP.battery - socKwh;
      const chargeable = Math.min(surplus, headroom/STEP_H/CHG_EFF);
      socKwh += chargeable*STEP_H*CHG_EFF;
      batteryFlow = -chargeable;
      const spilled = surplus-chargeable;
      decision = "renewable surplus: charging battery";
      if(spilled>1){
        decision = "renewable surplus exceeds battery headroom: charging battery, curtailing remainder";
        notes.push(`Curtailed ${spilled.toFixed(0)} kW of renewable surplus (battery full).`);
      }
    } else {
      let shortfall = residual;
      const usable = Math.max(0, socKwh - RESERVE_FLOOR/100*CAP.battery);
      const maxDis = usable*DIS_EFF/STEP_H;
      const fromBatt = Math.min(shortfall, maxDis);
      socKwh -= fromBatt*STEP_H/DIS_EFF;
      batteryFlow = fromBatt;
      shortfall -= fromBatt;
      decision = "shortfall covered by direct renewables + battery discharge";
 
      const fuelLimitedKw = fuel/FUEL_L_PER_KWH/STEP_H;
      const requestedDieselKw = Math.min(shortfall, CAP.diesel);
      if(shortfall>1 && dieselAvailable && fuelLimitedKw>0.5){
        dieselKw = Math.min(requestedDieselKw, fuelLimitedKw);
        shortfall -= dieselKw;
        if(dieselKw>0){
          decision = "shortfall exceeds safe battery discharge: dispatching diesel genset";
          notes.push(`Diesel genset dispatched at ${dieselKw.toFixed(0)} kW to cover shortfall.`);
          if(dieselKw < requestedDieselKw-1) notes.push("Diesel output fuel-limited — tank nearly empty.");
        }
      } else if(shortfall>1 && dieselAvailable && fuelLimitedKw<=0.5){
        notes.push("Diesel genset out of fuel — leaning harder on battery/shedding.");
      } else if(shortfall>1 && !dieselAvailable){
        decision = "shortfall persists and diesel is unavailable (fault): drawing harder on battery";
        notes.push("Diesel genset unavailable (fault) — leaning harder on battery/shedding.");
      }
 
      if(shortfall>1){
        const emKwh = Math.max(0, socKwh-EMERGENCY_FLOOR/100*CAP.battery);
        const emKw = Math.min(shortfall, emKwh*DIS_EFF/STEP_H);
        if(emKw>0){
          socKwh -= emKw*STEP_H/DIS_EFF;
          batteryFlow += emKw;
          shortfall -= emKw;
          decision = "diesel and normal battery reserve insufficient: drawing into emergency battery reserve";
          notes.push(`Drew battery into emergency reserve (${emKw.toFixed(0)} kW) to avoid shedding load.`);
        }
      }
 
      if(shortfall>1){
        const res = shedLoad(sectorLoads, shortfall);
        shedKw = res.shed; shedSectors = res.sectors; tier0Risk = res.tier0Risk;
        shortfall -= shedKw;
        if(shedSectors.length){
          decision = "all generation and storage exhausted: shedding load by priority tier";
          notes.push(`Load-shed ${shedKw.toFixed(0)} kW across: ${shedSectors.join(", ")}.`);
        }
        if(tier0Risk){
          decision = "shed capacity exhausted: Tier-0 critical load now at risk";
          notes.push("CRITICAL: shedding capacity exhausted — Tier-0 critical load is now at risk.");
          if(shortfall>1){
            notes.push(`${shortfall.toFixed(0)} kW of demand remains unserved beyond all shed capacity.`);
            unmetKw = shortfall;
          }
        }
      }
    }
 
    socKwh = Math.max(0, Math.min(CAP.battery, socKwh));
    battery = socKwh/CAP.battery*100;
 
    if(dieselKw>0) fuel = Math.max(0, fuel - dieselKw*STEP_H*FUEL_L_PER_KWH);
    if(resupplyEtaHours !== null) notes.push(`Diesel resupply in transit — fuel delivery expected in ~${resupplyEtaHours.toFixed(0)}h.`);
    else if(fuel < RESUPPLY_THRESHOLD_L) notes.push(`Diesel fuel low: ${fuel.toFixed(0)} L remaining — resupply will be called automatically below threshold.`);
 
    if(!decision) decision = "demand fully met from available generation and storage";
 
    const served = demand - shedKw - unmetKw;
    const cleanFraction = served<=0 ? 0 : Math.max(0, Math.min(1, (served-dieselKw)/served));
    const directRenFraction = served<=0 ? 0 : Math.max(0, Math.min(1, Math.min(renewable,served)/served));
 
    const trace = {
      observation: {demandKw:demand, renewableKw:renewable, residualKw:residual,
        batterySocPctBefore:socBeforePct, dieselAvailable, sensorFaults:faults},
      constraints,
      decision,
      actions: notes.length ? notes.slice() : ["No corrective action required this cycle."],
      result: {batterySocPctAfter:battery, dieselKw, shedKw, shedSectors, unmetKw,
        renewableFraction:cleanFraction, tier0Risk},
    };
 
    const state = {t:new Date(simT), solarKw, windKw, windSpeed, cloud, ambientTemp, storm:stormActive, faults,
      desalFlow, desalPressure, sectorLoads, demand, renewable, dieselResupplyEtaHours:resupplyEtaHours};
    const dispatch = {demand, renewable, batteryFlow, dieselKw, shedKw, shedSectors, tier0Risk, unmetKw,
      batterySoc:battery, fuel, cleanFraction, directRenFraction, notes, trace};
 
    lastState = state; lastDispatch = dispatch;
    history.push({state, dispatch});
    if(history.length>HISTORY_MAX) history.shift();
 
    runAgent(state, dispatch);
    render();
    demoTick();
  }
 
  function shedLoad(sectorLoads, needed){
    let remaining = needed, shedTotal=0, shedSectors=[];
    for(const tier of [2,1]){
      let sectors = SECTORS.filter(s=>s.tier===tier);
      if(tier===1){
        const p = shedPointer % sectors.length;
        sectors = sectors.slice(p).concat(sectors.slice(0,p));
        shedPointer++;
      }
      for(const s of sectors){
        if(remaining<=1) break;
        const load = sectorLoads[s.name]||0;
        const sheddable = load*s.shed;
        const take = Math.min(sheddable, remaining);
        if(take>0.5){ shedTotal+=take; remaining-=take; shedSectors.push(s.name); }
      }
      if(remaining<=1) break;
    }
    return {shed:shedTotal, sectors:shedSectors, tier0Risk: remaining>1};
  }
 
  /* ============================== AGENT (fallback reasoning, ported from claude_advisor.py) ============================== */
  function fmtTime(d){
    return d.toLocaleString('en-US',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false});
  }
 
  function agentEntryHtml(a){
    const sevTag = a.sev==='critical' ? 'CRIT' : a.sev.toUpperCase();
    return `<tr class="${a.sev==='critical'?'critical':''}">
        <td class="ts">${fmtTime(a.t)}</td>
        <td class="sev ${a.sev}">[${sevTag}]</td>
        <td class="msg">${a.text}</td>
      </tr>`;
  }
 
  // Inserts incrementally (rather than rebuilding the whole log on every
  // tick) so a full innerHTML rebuild doesn't happen dozens of times a
  // second at fast-forward speeds. Also drops back-to-back duplicate
  // messages (e.g. the same critical alert repeating every tick while a
  // fault is ongoing) so the log reads as discrete events, not a spool.
  function pushAgent(sev, text){
    if(agentLog.length && agentLog[0].sev===sev && agentLog[0].text===text) return;
    const entry = {t:new Date(simT), sev, text};
    agentLog.unshift(entry);
    if(agentLog.length>60) agentLog.pop();
    const feed = document.getElementById('agentFeed');
    if(feed){
      const placeholder = feed.querySelector('.eventlog-empty-row');
      if(placeholder) placeholder.remove();
      feed.insertAdjacentHTML('afterbegin', agentEntryHtml(entry));
      while(feed.children.length>30) feed.removeChild(feed.lastElementChild);
    }
  }
 
  let ticksSinceBrief = 0;
  function runAgent(state, dispatch){
    // Anomaly triage — reasons over correlated signals, not single thresholds.
    const recentFlow = history.slice(-6).map(h=>h.state.desalFlow);
    if(recentFlow.length>=4 && (Math.max(...recentFlow)-Math.min(...recentFlow) < 0.5)){
      pushAgent("warn", `Desalination flow reading unchanged for ${recentFlow.length} cycles despite normal demand variation — pattern matches a STUCK SENSOR, not a real process change. Recommend a technician verify the flow meter before trusting flow-based desal decisions.`);
    } else if(state.faults.includes("desal_flow_sensor_stuck")){
      pushAgent("warn", "Desalination flow sensor flagged stuck. Pressure is still varying normally, which points to the meter having failed rather than the pump — low risk to water supply, but flow-based logic should fall back to pressure until repaired.");
    }
    if(state.faults.includes("diesel_genset_fault") && dispatch.batterySoc<25){
