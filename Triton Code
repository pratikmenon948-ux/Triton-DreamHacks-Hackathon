  // The chart is the single most expensive render step: it wipes and rebuilds
  // the whole SVG (gridlines, 4 series paths + area fills, axis labels, hover
  // overlay) on every call. tick() can fire faster than the display repaints
  // at high simulation speed, and redrawing more often than the screen can
  // show is pure wasted work — so tick()/render() no longer call renderChart()
  // directly. They call requestChartRender(), which coalesces any number of
  // calls within one frame into a single rebuild via requestAnimationFrame,
  // capping chart re-renders at the display's actual refresh rate regardless
  // of simulation speed. This also means chart rebuilds automatically stop
  // while the tab is backgrounded, since browsers don't run rAF callbacks for
  // hidden tabs — a real CPU/battery saving for a dashboard left running.
  let chartRafPending = false;
  function requestChartRender(){
    if(chartRafPending) return;
