  // ClaudeGridAdvisor._answer_fallback() in claude_advisor.py — not a
  // keyword-to-latest-log-line lookup. This IS the artifact's honest
  // ceiling: a published Claude Artifact cannot call the Anthropic API
  // (its CSP blocks arbitrary network calls), so this deterministic router
  // is what runs here. The reference Python backend (see README) calls the
  // real Claude API over this same structured trace when ANTHROPIC_API_KEY
  // is set — that live path can only be demonstrated by running it, not
  // inside a published artifact.
  const FALLBACK_PREFIX = "[Local fallback — deterministic, not Claude]";
  function answerQuestion(q){
    if(!history.length) return `${FALLBACK_PREFIX} No grid history logged yet this session.`;
    const lower = q.toLowerCase();
    const d = lastDispatch, s = lastState;
 
    if(/protect|never shed|tier ?0|tier-0|critical load/.test(lower)){
      const names = SECTORS.filter(x=>x.tier===0).map(x=>x.name).join(", ");
      return `${FALLBACK_PREFIX} Tier-0 (never automatically shed): ${names}. The dispatch engine only sheds Tier-2 (deferrable) load first, then rotates through Tier-1 (essential); Tier-0 is excluded by construction, not a runtime check — see shedLoad().`;
    }
    if(/shed|blackout|outage|went out|lost power/.test(lower)){
      const withShed = [...history].reverse().find(h=>h.dispatch.shedSectors.length);
      if(!withShed) return `${FALLBACK_PREFIX} No load-shedding event in the last ${history.length} logged cycles.`;
      const t = withShed.dispatch.trace;
      return `${FALLBACK_PREFIX} Most recent load-shed event at ${fmtTime(withShed.state.t)}: ${t.decision}. Shed ${t.result.shedKw.toFixed(0)} kW across ${t.result.shedSectors.join(", ")||"no sectors"}. Cause: demand of ${t.observation.demandKw.toFixed(0)} kW exceeded renewables (${t.observation.renewableKw.toFixed(0)} kW) by more than battery + diesel capacity could cover after the reserve floor.`;
    }
    if(/fuel|diesel/.test(lower)){
      if(/if |fail|what happens/.test(lower)){
        return `${FALLBACK_PREFIX} Counterfactual (not a live re-simulation): if the diesel genset failed right now, the ${d.dieselKw.toFixed(0)} kW it currently supplies would have to come from battery (currently ${d.batterySoc.toFixed(0)}% SOC) down to the emergency floor, then from load-shedding. Given current demand of ${d.demand.toFixed(0)} kW against ${d.renewable.toFixed(0)} kW renewables, expect Tier-2 and likely Tier-1 shedding within 1-2 cycles — trigger the Genset flt scenario for a real, not hypothetical, simulation of this.`;
      }
      const eta = s.dieselResupplyEtaHours;
      const resupplyNote = eta!=null ? ` A fuel delivery is in transit, ETA ~${eta.toFixed(0)}h.` : "";
      return `${FALLBACK_PREFIX} Diesel is currently supplying ${d.dieselKw.toFixed(0)} kW with ${d.fuel.toFixed(0)} L remaining in the tank.${resupplyNote}`;
    }
    if(/battery|soc|state of charge/.test(lower)){
      return `${FALLBACK_PREFIX} Battery is at ${d.batterySoc.toFixed(0)}% SOC. Normal reserve floor is ${RESERVE_FLOOR}%; the optimizer only discharges below that (down to a ${EMERGENCY_FLOOR}% emergency floor) to avoid shedding load.`;
    }
    if(/renewable|clean|solar|wind/.test(lower)){
      return `${FALLBACK_PREFIX} Clean fraction (direct renewables + renewable-charged battery) is currently ${(d.cleanFraction*100).toFixed(0)}%; direct solar+wind share of served demand is ${(d.directRenFraction*100).toFixed(0)}%. These differ because diesel never charges the battery in this model, so stored energy is always renewable-sourced.`;
    }
    if(/risk|worst|worried|concern/.test(lower)){
      if(d.tier0Risk) return `${FALLBACK_PREFIX} Highest current risk: Tier-0 critical load is at risk right now — all shed capacity is exhausted.`;
      if(s.faults.length) return `${FALLBACK_PREFIX} Highest current risk: active sensor/equipment fault(s): ${s.faults.join(", ")}.`;
      if(d.batterySoc<25) return `${FALLBACK_PREFIX} Highest current risk: battery SOC is low (${d.batterySoc.toFixed(0)}%) with limited buffer before shedding would be needed.`;
      return `${FALLBACK_PREFIX} No elevated risk in the current cycle — system nominal.`;
    }
    if(/recommend|next action|what should|do next/.test(lower)){
      if(d.tier0Risk) return `${FALLBACK_PREFIX} Recommended action: manual intervention (emergency diesel resupply or negotiated demand reduction) — automated shedding capacity is exhausted.`;
      if(d.trace.actions[0] !== "No corrective action required this cycle.") return `${FALLBACK_PREFIX} System is already acting: ${d.trace.actions.join("; ")}`;
      return `${FALLBACK_PREFIX} No action required — demand is fully served within normal operating margins.`;
    }
    if(/sensor|stuck|anomaly|fault/.test(lower)){
      if(s.faults.length) return `${FALLBACK_PREFIX} Active fault(s): ${s.faults.join(", ")}. See the event log for the triage reasoning logged when this was first detected.`;
      return `${FALLBACK_PREFIX} No sensor or equipment faults active in the current cycle.`;
    }
    return `${FALLBACK_PREFIX} Most recent decision (${fmtTime(s.t)}): ${d.trace.decision}. Ask about 'shed', 'fuel', 'battery', 'renewable', 'risk', 'recommend', or 'sensor' for a more specific grounded answer — this router reasons over the same decision trace the Python backend sends to Claude when ANTHROPIC_API_KEY is set.`;
