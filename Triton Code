    const svg = document.getElementById('chartSvg');
    if(!history.length) return;
    const W=900,H=230, padL=8, padR=8, padT=10, padB=22;
    const plotW = W-padL-padR, plotH = H-padT-padB;
    const n = history.length;
    const maxV = Math.max(50, ...history.flatMap(h=>CHART_SERIES.map(s=>s.from(h))));
    const x = i => padL + (n<=1?0:(i/(n-1))*plotW);
    const y = v => padT + plotH - (v/maxV)*plotH;
 
    svg.innerHTML='';
    // gridlines
    const gl = el('g',{},svg);
    for(let k=0;k<=3;k++){
      const yy = padT + plotH*k/3;
      el('line',{class:'gridline', x1:padL, x2:W-padR, y1:yy, y2:yy}, gl);
    }
    CHART_SERIES.forEach(s=>{
      const pts = history.map((h,i)=>[x(i), y(s.from(h))]);
      const d = pts.map((p,i)=>(i===0?'M':'L')+p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ');
      const path = el('path',{class:'series-path', d, stroke:s.color}, svg);
      if(s.dashed) path.setAttribute('stroke-dasharray','5 4');
      if(!s.dashed){
        const areaD = d + ` L${x(n-1).toFixed(1)},${(padT+plotH).toFixed(1)} L${x(0).toFixed(1)},${(padT+plotH).toFixed(1)} Z`;
        el('path',{class:'series-area', d:areaD, fill:s.color}, svg);
      }
    });
    // hover line
    const hoverLine = el('line',{class:'chart-hover-line', id:'hoverLine', x1:0,x2:0,y1:padT,y2:padT+plotH}, svg);
    // x-axis time labels (start / mid / end)
    [0, Math.floor((n-1)/2), n-1].forEach(i=>{
      if(i<0||i>=n) return;
      el('text',{class:'chart-axis-label', x:x(i), y:H-6, 'text-anchor': i===0?'start':(i===n-1?'end':'middle')}, svg).textContent =
        history[i].state.t.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',hour12:false});
    });
 
    chartLayout = {W,H,padL,padR,padT,padB,plotW,plotH,x,y,maxV,n};
 
    // hover interaction
    const overlay = el('rect',{x:padL,y:padT,width:plotW,height:plotH,fill:'transparent'}, svg);
    overlay.style.cursor='crosshair';
    overlay.onmousemove = (ev)=>onChartHover(ev, svg);
    overlay.onmouseleave = ()=>{ hoverLine.style.opacity=0; document.getElementById('chartTooltip').style.opacity=0; };
  }
 
  function onChartHover(ev, svg){
    if(!chartLayout) return;
    const rect = svg.getBoundingClientRect();
    const px = (ev.clientX-rect.left) / rect.width * chartLayout.W;
    const idx = Math.round((px-chartLayout.padL)/chartLayout.plotW*(chartLayout.n-1));
    const clamped = Math.max(0, Math.min(chartLayout.n-1, idx));
    const h = history[clamped];
    if(!h) return;
    const hoverLine = document.getElementById('hoverLine');
    const xx = chartLayout.x(clamped);
    hoverLine.setAttribute('x1',xx); hoverLine.setAttribute('x2',xx);
    hoverLine.style.opacity = 1;
    const tt = document.getElementById('chartTooltip');
    tt.innerHTML = `<div style="margin-bottom:4px;color:var(--ink-muted)">${h.state.t.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',hour12:false})}</div>` +
      CHART_SERIES.map(s=>`<div class="tt-row"><span style="color:${s.color}">${s.label}</span><span>${s.from(h).toFixed(0)} kW</span></div>`).join('');
    const wrapRect = svg.parentElement.getBoundingClientRect();
    const px2 = (xx/chartLayout.W)*wrapRect.width;
    tt.style.left = Math.min(wrapRect.width-140, Math.max(4,px2+8))+'px';
    tt.style.top = '6px';
    tt.style.opacity = 1;
  }
 
  // Full rebuild — used once at startup only. Later updates go through
  // pushAgent()'s incremental insert.
  function renderAgent(){
    const feed = document.getElementById('agentFeed');
    feed.innerHTML = agentLog.slice(0,30).map(agentEntryHtml).join('') ||
      `<tr class="eventlog-empty-row"><td colspan="3" class="eventlog-empty">No events logged.</td></tr>`;
  }
 
  function renderSectors(){
    const s = lastState, d = lastDispatch;
    const tbody = document.getElementById('sectorsBody');
    tbody.innerHTML = SECTORS.map(sec=>{
      const load = s.sectorLoads[sec.name]||0;
      const isShed = d.shedSectors.includes(sec.name);
      const barColor = sec.tier===0?'var(--status-critical)':(sec.tier===1?'var(--accent-battery)':'var(--ink-muted)');
      return `<tr>
        <td>${sec.name}</td>
        <td><span class="tier-tag t${sec.tier}">T${sec.tier}</span></td>
        <td class="kw">${load.toFixed(0)} kW</td>
        <td><div class="bar-cell"><div class="bar-track"><div class="bar-fill" style="width:${(sec.shed*100).toFixed(0)}%;background:${barColor}"></div></div><span class="kw" style="color:var(--ink-muted)">${(sec.shed*100).toFixed(0)}%</span></div></td>
        <td><span class="status-chip ${isShed?'shed':'normal'}"><span class="d"></span>${isShed?'Shedding':'Normal'}</span></td>
      </tr>`;
    }).join('');
  }
 
  function renderHeader(){
    document.getElementById('simTime').textContent = simT.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',hour12:false});
    document.getElementById('simDate').textContent = simT.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',year:'numeric'});
    document.getElementById('telemetryUpdated').textContent = simT.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',hour12:false});
 
    const d = lastDispatch, s = lastState;
    const pill = document.getElementById('healthPill'), label = document.getElementById('healthLabel');
    let cls='good', text='Nominal';
    if(d.tier0Risk){ cls='critical'; text='Critical — Tier-0 at risk'; }
    else if(d.shedSectors.length || s.faults.length){ cls='warn'; text='Degraded'; }
    pill.className = 'health '+cls; label.textContent = text;
 
    // System frequency/voltage are illustrative EMS-style readouts derived
    // from grid stress (real islanded grids sag in frequency under a supply
    // deficit) — not an independently modeled electromechanical simulation.
    const stress = d.tier0Risk ? 1 : (d.shedKw>1 ? Math.min(1, d.shedKw/150) : 0);
    const freq = 60.00 - stress*0.42 - (d.dieselKw>CAP.diesel*0.9 ? 0.05 : 0);
    const volt = 13.80 - stress*0.55 - (d.dieselKw>CAP.diesel*0.9 ? 0.08 : 0);
    const freqEl = document.getElementById('statFreq'), voltEl = document.getElementById('statVoltage');
    freqEl.textContent = freq.toFixed(2)+' Hz';
    voltEl.className = 'val mono' + (stress>0.6?' critical':(stress>0.15?' warn':''));
    voltEl.textContent = volt.toFixed(2)+' kV';
    freqEl.className = 'val mono' + (stress>0.6?' critical':(stress>0.15?' warn':''));
 
    document.querySelectorAll('.scenario-btn').forEach(b=>{
      b.dataset.armed = (b.dataset.scenario===scenario) ? 'true' : 'false';
    });
  }
 
  function render(){
    renderGauges();
    renderMap();
    renderFlow();
    requestChartRender(); // throttled to one rebuild per animation frame — see definition above
    renderSectors();
    renderHeader();
    renderDecisionBar();
  }
 
  /* ============================== DECISION BAR / WHY / IMPACT ============================== */
  function renderDecisionBar(){
    const d = lastDispatch;
    const riskEl = document.getElementById('decisionRisk'), riskLabel = document.getElementById('decisionRiskLabel');
    let cls='good', label='Nominal';
    if(d.tier0Risk){ cls='critical'; label='Critical'; }
    else if(d.shedSectors.length || lastState.faults.length){ cls='warn'; label='Degraded'; }
    riskEl.className = 'decision-risk '+cls;
    riskLabel.textContent = label;
    document.getElementById('decisionText').textContent = d.trace.decision;
    if(!document.getElementById('whyDrawer').hidden) renderTraceDrawer();
    if(!document.getElementById('impactDrawer').hidden) renderImpactDrawer();
  }
 
  function traceBlock(label, bodyHtml){
    return `<div class="trace-block"><div class="t-label">${label}</div><div class="t-body">${bodyHtml}</div></div>`;
  }
 
  function renderTraceDrawer(){
    const t = lastDispatch.trace;
    const o = t.observation, r = t.result;
    document.getElementById('traceGrid').innerHTML = [
      traceBlock('Observation', `Demand <code>${o.demandKw.toFixed(0)} kW</code> vs. renewables <code>${o.renewableKw.toFixed(0)} kW</code>
        (residual <code>${o.residualKw>=0?'+':''}${o.residualKw.toFixed(0)} kW</code>).
        Battery was <code>${o.batterySocPctBefore.toFixed(0)}%</code> SOC before this cycle.
        Diesel ${o.dieselAvailable?'available':'<strong style="color:var(--status-critical)">unavailable (fault)</strong>'}.
        ${o.sensorFaults.length?`Active faults: <code>${o.sensorFaults.join(', ')}</code>.`:'No sensor faults.'}`),
      traceBlock('Constraints considered', `<ul>${t.constraints.map(c=>`<li>${c}</li>`).join('')}</ul>`),
      traceBlock('Decision', `<strong>${t.decision}</strong>`),
      traceBlock('Actions taken', `<ul>${t.actions.map(a=>`<li>${a}</li>`).join('')}</ul>`),
      traceBlock('Result', `Battery now <code>${r.batterySocPctAfter.toFixed(0)}%</code> SOC ·
        diesel <code>${r.dieselKw.toFixed(0)} kW</code> ·
        shed <code>${r.shedKw.toFixed(0)} kW</code>${r.shedSectors.length?` (${r.shedSectors.join(', ')})`:''} ·
        clean fraction <code>${(r.renewableFraction*100).toFixed(0)}%</code>
        ${r.tier0Risk?'· <strong style="color:var(--status-critical)">Tier-0 at risk</strong>':''}`),
    ].join('');
  }
 
  function renderImpactDrawer(){
    if(!history.length) return;
    const n = history.length;
    const hoursSpan = n*STEP_H;
    let dieselKwh=0, naiveKwh=0, shedKwh=0, renewSum=0, minSoc=100, tier0Ticks=0;
    for(const h of history){
      dieselKwh += h.dispatch.dieselKw*STEP_H;
      naiveKwh += h.dispatch.demand*STEP_H;
      shedKwh += h.dispatch.shedKw*STEP_H;
      renewSum += h.dispatch.cleanFraction;
      minSoc = Math.min(minSoc, h.dispatch.batterySoc);
      if(h.dispatch.tier0Risk) tier0Ticks++;
    }
    const fuelUsedL = dieselKwh*FUEL_L_PER_KWH, naiveFuelL = naiveKwh*FUEL_L_PER_KWH;
    const fuelSavedL = naiveFuelL - fuelUsedL;
    const fuelSavedPct = naiveFuelL>0 ? 100*fuelSavedL/naiveFuelL : 0;
    const avgClean = 100*renewSum/n;
    const tier0ProtectedPct = 100*(n-tier0Ticks)/n;
    const shedEvents = agentLog.filter(a=>a.sev==='warn'||a.sev==='critical').length;
    const stat = (label, value, sub)=>`<div class="impact-stat"><div class="i-label">${label}</div><div class="i-value">${value}</div>${sub?`<div class="i-sub">${sub}</div>`:''}</div>`;
    document.getElementById('impactGrid').innerHTML = [
      stat('Window', `${hoursSpan.toFixed(1)}h`, `${n} ticks logged this session`),
      stat('Critical load protected', `${tier0ProtectedPct.toFixed(1)}%`, tier0Ticks ? `at risk on ${tier0Ticks} of ${n} ticks` : 'never at risk this session'),
      stat('Diesel fuel saved', `${fuelSavedPct.toFixed(0)}%`, `${fuelSavedL.toFixed(0)} L avoided (${fuelUsedL.toFixed(0)} L used vs. ${naiveFuelL.toFixed(0)} L naive baseline)`),
      stat('Avg. clean fraction', `${avgClean.toFixed(0)}%`, 'direct renewables + renewable-charged battery'),
      stat('Energy shed', `${shedKwh.toFixed(0)} kWh`, `${(100*shedKwh/(naiveKwh||1)).toFixed(1)}% of demand`),
      stat('Min. battery SOC', `${minSoc.toFixed(0)}%`, `reserve floor ${RESERVE_FLOOR}%`),
      stat('Tier-0 risk ticks', `${tier0Ticks}`, tier0Ticks ? 'critical load at risk' : 'never exhausted shed capacity'),
    ].join('');
  }
 
  /* ============================== INIT / LOOP / EVENTS ============================== */
  initFlowSvg();
  initMapSvg();
  // seed some history so the chart isn't empty on load
  for(let i=0;i<32;i++) tick();
  render(); renderAgent();
 
  let timer=null;
  function scheduleLoop(){
    if(timer) clearInterval(timer);
    if(speed<=0) return;
    const intervalMs = Math.max(60, 260/speed);
    timer = setInterval(tick, intervalMs);
  }
  scheduleLoop();
 
  document.getElementById('speedSeg').addEventListener('click', e=>{
    const btn = e.target.closest('button'); if(!btn) return;
    speed = Number(btn.dataset.speed);
    document.querySelectorAll('#speedSeg button').forEach(b=>b.classList.toggle('active', b===btn));
    scheduleLoop();
  });
 
  document.getElementById('viewSeg').addEventListener('click', e=>{
    const btn = e.target.closest('button'); if(!btn) return;
    const view = btn.dataset.view;
    document.querySelectorAll('#viewSeg button').forEach(b=>b.classList.toggle('active', b===btn));
    document.getElementById('mapView').hidden = view!=='map';
    document.getElementById('schematicView').hidden = view!=='schematic';
    document.getElementById('viewTitle').innerHTML = view==='map'
      ? 'Site map <span class="aux">Kailoa Island — fictional, illustrative layout</span>'
      : 'One-line diagram <span class="aux">instantaneous dispatch</span>';
  });
 
  document.querySelectorAll('.scenario-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const sc = btn.dataset.scenario;
      if(sc==='clear'){ scenario=null; scenarioTicksLeft=0; stuckVal=null; pushAgent('info','Active scenario cleared manually by operator.'); return; }
      scenario = sc; scenarioTicksLeft = sc==='generator_fault' ? 6 : (sc==='sensor_stuck'?20:28);
      stuckVal = null;
      const names = {storm:'Storm', generator_fault:'Generator fault', sensor_stuck:'Sensor fault'};
      pushAgent('warn', `Scenario triggered by operator: ${names[sc]}.`);
    });
  });
 
  document.getElementById('askBtn').addEventListener('click', submitAsk);
  document.getElementById('askInput').addEventListener('keydown', e=>{ if(e.key==='Enter') submitAsk(); });
  // The event log renders entry text as HTML (agentEntryHtml in advisor.js),
  // so anything that echoes free-typed operator input has to escape it first
  // — otherwise typing e.g. "<img src=x onerror=...>" into the ask box would
  // execute as markup instead of displaying as a question.
  function escapeHtml(str){
    return String(str).replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  }
  function submitAsk(){
    const input = document.getElementById('askInput');
    const q = input.value.trim();
    if(!q) return;
    pushAgent('info', `<strong>Operator asked:</strong> "${escapeHtml(q)}"`);
    const ans = answerQuestion(q);
    pushAgent('info', ans);
    input.value='';
  }
 
  /* ============================== WHY / IMPACT / ARCHITECTURE UI ============================== */
  function toggleDrawer(id, btnId, onOpenRender){
    const drawer = document.getElementById(id), btn = document.getElementById(btnId);
    const opening = drawer.hidden;
    drawer.hidden = !opening;
    btn.setAttribute('aria-expanded', String(opening));
    if(opening) onOpenRender();
  }
  document.getElementById('whyBtn').addEventListener('click', ()=>toggleDrawer('whyDrawer','whyBtn',renderTraceDrawer));
  document.getElementById('impactBtn').addEventListener('click', ()=>toggleDrawer('impactDrawer','impactBtn',renderImpactDrawer));
  document.getElementById('archBtn').addEventListener('click', ()=>{ document.getElementById('archOverlay').hidden = false; });
  document.getElementById('archCloseBtn').addEventListener('click', ()=>{ document.getElementById('archOverlay').hidden = true; });
  document.getElementById('archOverlay').addEventListener('click', e=>{ if(e.target.id==='archOverlay') e.currentTarget.hidden = true; });
  document.addEventListener('keydown', e=>{ if(e.key==='Escape') document.getElementById('archOverlay').hidden = true; });
 
  /* ============================== CRISIS DEMO MODE ============================== */
  // A deterministic, scripted 7-phase sequence a presenter can run with one
  // click and narrate against, instead of describing failure modes in
  // slides. Every step drives the same tick()/dispatch() the rest of the
  // dashboard uses — nothing here is faked or pre-recorded.
  const DEMO_SCRIPT = [
    {ticks:8, caption:'Normal operation — solar and wind cover most of demand, battery holding steady.'},
    {ticks:28, action:()=>{ scenario='storm'; scenarioTicksLeft=28; stuckVal=null; }, caption:'Storm arriving — cloud cover spikes, solar output collapses, wind rises.'},
    {ticks:10, caption:'Battery discharging to absorb the shortfall as solar stays suppressed.'},
    {ticks:6, action:()=>{ scenario='generator_fault'; scenarioTicksLeft=6; }, caption:'Diesel genset fails mid-storm — a compounding fault on top of the weather event.'},
    {ticks:6, caption:'Battery drawn into emergency reserve; deferrable (Tier-2) load begins shedding.'},
    {ticks:10, action:()=>{ scenario=null; scenarioTicksLeft=0; }, caption:'Faults clear — genset restored, storm passing. Recovery begins.'},
    {ticks:10, caption:'Back to nominal. Open "24h impact" to see the tally from this run.'},
  ];
  function demoRenderControls(){
    const wrap = document.getElementById('demoControls');
    if(!demo){
      wrap.innerHTML = `<button class="btn" id="demoStartBtn" aria-label="Run scripted crisis demo">Run crisis demo</button>`;
      document.getElementById('demoStartBtn').addEventListener('click', demoStart);
      return;
    }
    const stepLabel = `Step ${demo.step+1}/${DEMO_SCRIPT.length}`;
    const pauseLabel = demo.paused ? 'Resume crisis demo' : 'Pause crisis demo';
    wrap.innerHTML = `
      <span class="decision-label" style="align-self:center;" aria-live="polite">${stepLabel}</span>
      <button class="btn" id="demoPauseBtn" aria-label="${pauseLabel}">${demo.paused?'Resume':'Pause'}</button>
      <button class="btn" id="demoSkipBtn" aria-label="Skip to next demo step">Skip</button>
      <button class="btn" id="demoResetBtn" aria-label="Reset crisis demo">Reset</button>`;
    document.getElementById('demoPauseBtn').addEventListener('click', demoTogglePause);
    document.getElementById('demoSkipBtn').addEventListener('click', ()=>demoAdvance(true));
    document.getElementById('demoResetBtn').addEventListener('click', demoReset);
  }
 
  function demoStart(){
    demo = {step:-1, ticksLeft:0, savedSpeed:speed, paused:false};
    pushAgent('info', 'Crisis demo started — scripted, deterministic sequence driving the same dispatch engine as manual scenario buttons.');
    speed = 4;
    document.querySelectorAll('#speedSeg button').forEach(b=>b.classList.toggle('active', Number(b.dataset.speed)===4));
    scheduleLoop();
    demoAdvance(false);
  }
 
  function demoAdvance(isSkip){
    demo.step++;
    if(demo.step >= DEMO_SCRIPT.length){ demoReset(); return; }
    const step = DEMO_SCRIPT[demo.step];
    demo.ticksLeft = step.ticks;
    if(step.action) step.action();
    pushAgent(isSkip?'info':'warn', `Demo step ${demo.step+1}/${DEMO_SCRIPT.length}: ${step.caption}`);
    demoRenderControls();
  }
 
  function demoTogglePause(){
    demo.paused = !demo.paused;
    speed = demo.paused ? 0 : 4;
    scheduleLoop();
    demoRenderControls();
  }
 
  function demoReset(){
    if(demo){ speed = demo.savedSpeed; }
    demo = null;
    scenario = null; scenarioTicksLeft = 0; stuckVal = null;
    document.querySelectorAll('#speedSeg button').forEach(b=>b.classList.toggle('active', Number(b.dataset.speed)===speed));
    scheduleLoop();
    demoRenderControls();
  }
 
  // Called from tick() via demoTick() below so the script advances in
  // simulation time (ticks), not wall-clock time — pausing the sim pauses the demo too.
  function demoTick(){
    if(!demo || demo.paused) return;
    demo.ticksLeft--;
    if(demo.ticksLeft <= 0) demoAdvance(false);
  }
 
  demoRenderControls();
 
  renderChartLegend();
})();
</script>
 
